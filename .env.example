# ==========================================
# NIRVANA Smart Safety Footwear - Environment Template
# Copy this file to .env and adjust variables as needed.
# ==========================================

# Application Metadata
VITE_APP_NAME="NIRVANA Smart Safety Footwear"
VITE_APP_SHORT_NAME="NIRVANA"
VITE_APP_TAGLINE="Connected Industrial Safety Sole & IoT Showcase"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"

# Server & Network Configuration
VITE_PORT=3000
VITE_HOST="localhost"
VITE_API_BASE_URL="http://localhost:3000/api"

# Telemetry & IoT Simulation Settings
VITE_ENABLE_MOCK_TELEMETRY=true
VITE_TELEMETRY_REFRESH_RATE_MS=1000

# Enterprise & Support Contact
VITE_CONTACT_EMAIL="enterprise@apex-soletech.com"

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_DEBUG_MODE=false
